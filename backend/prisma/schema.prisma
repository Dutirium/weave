generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Stance{
  SUPPORT
  CHALLENGE
  NEUTRAL
}

enum ArgumentRelation{

  REPLY
  SUPPORT 
  CHALLENGE
  COUNTER
  QUESTION

}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  credibility Int @default(0) // added user credit Score 

  weave        Weave[]
  messages     Messages[]
  sessions     Session[]
  stances      WeaveStance[]
  posts        Post[]
}

model Session {
  session_id String @id 
  user_id String
  expires_at DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade )

  @@index([user_id])
}

model Weave {
  id String @id @default(uuid())
  creator String
  title String
  totalSwitches Int @default(0)
  createdAt DateTime @default(now())
  
  //The user here could be used as a property to get all the user data in one go example Weave.user 
  user User @relation(fields: [creator], references: [id], onDelete: Cascade)
  
  messages Messages[]
  stances WeaveStance[]

}

model Messages{
  id String @id @default(uuid())
  content String
  weave_id String 
  user_id String
  clientMessage_id String?
  target_message_id String?
  relation ArgumentRelation?
  sequence  Int
  createdAt DateTime @default(now())
  stance Stance

  weave Weave @relation(fields: [weave_id], references: [id], onDelete: Cascade )
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  targetMessage Messages? @relation("MessageReplies", fields: [target_message_id], references: [id])

  replies Messages[] @relation("MessageReplies")

  @@unique([weave_id, clientMessage_id], map: "weave_id_clientMessage_id")
  @@unique([weave_id, sequence])
  @@index([weave_id,sequence])
  @@index([target_message_id])


  @@index([weave_id])
}

model WeaveStance{
  id String @id @default(uuid())
  user_id String
  weave_id String
  stance Stance
  switch Int @default(3) //Added switch  
  createdAt DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade )
  weave Weave @relation(fields: [weave_id], references: [id], onDelete: Cascade )

  @@unique([user_id,weave_id])
  @@index([user_id])
  @@index([weave_id, stance])
}

model Post{
  user_id String
  id String @id @default(uuid())
  title String
  link String
  content String
  createdAt DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade )
}